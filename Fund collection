<!DOCTYPE html>
<html lang="ml">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ഫണ്ട് കളക്ഷൻ കാൽക്കുലേറ്റർ</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f9;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 500px;
            margin: auto;
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
        h2 {
            text-align: center;
            color: #333;
        }
        .form-group {
            margin-bottom: 15px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: #555;
        }
        input {
            width: 100%;
            padding: 10px;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 16px;
        }
        button {
            width: 100%;
            background-color: #28a745;
            color: white;
            padding: 12px;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            font-weight: bold;
        }
        button:hover {
            background-color: #218838;
        }
        .total-box {
            margin-top: 20px;
            padding: 15px;
            background-color: #e9ecef;
            border-radius: 5px;
            text-align: center;
            font-size: 20px;
            font-weight: bold;
            color: #333;
        }
        .list-container {
            margin-top: 20px;
            max-height: 250px;
            overflow-y: auto;
            border-top: 1px solid #ddd;
            padding-top: 10px;
        }
        .list-item {
            display: flex;
            justify-content: space-between;
            padding: 8px 5px;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }
        .delete-btn {
            background: #dc3545;
            color: white;
            border: none;
            padding: 2px 6px;
            border-radius: 3px;
            cursor: pointer;
            font-size: 12px;
        }
        .sync-info {
            margin-top: 10px;
            font-size: 12px;
            color: #666;
            text-align: center;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>ഫണ്ട് കളക്ഷൻ (Sheet Sync)</h2>
    
    <div class="form-group">
        <label for="houseName">വീടിന്റെ പേര് (house Name):</label>
        <input type="text" id="houseName" placeholder="ഉദാ: വീട്ടുപേര് അല്ലെങ്കിൽ നമ്പർ">
    </div>

    <div class="form-group">
        <label for="amount">തുക (amount):</label>
        <input type="number" id="amount" placeholder="തുക നൽകുക">
    </div>

    <button onclick="addEntry()">ചേർക്കുക</button>

    <div class="total-box">
        ആകെ തുക: ₹ <span id="totalAmount">0</span>
    </div>

    <div class="sync-info" id="syncStatus">ഷീറ്റിൽ നിന്നുള്ള വിവരങ്ങൾ ലോഡ് ചെയ്യുന്നു...</div>

    <div class="list-container" id="listContainer">
        <!-- ചേർത്ത വിവരങ്ങൾ ഇവിടെ കാണിക്കും -->
    </div>
</div>

<script>
    const csvUrl = "https://docs.google.com/spreadsheets/d/e/2PACX-1vS2dxtPZnFebCXIBEts69yxyruIXAGZ7mlYG5YuZcEECGWjlMUe40IL1MJITDUA6KXJ8fRM4pWykLR1/pub?output=csv";
    
    let total = 0;
    let entries = [];

    // പേജ് ലോഡ് ചെയ്യുമ്പോൾ ഗൂഗിൾ ഷീറ്റിലുള്ള വിവരങ്ങൾ സിങ്ക് ചെയ്യുക
    window.onload = function() {
        fetchDataFromSheet();
    };

    function fetchDataFromSheet() {
        fetch(csvUrl)
            .then(response => response.text())
            .then(data => {
                parseCSV(data);
                document.getElementById('syncStatus').innerText = "ഷീറ്റുമായി കണക്റ്റ് ചെയ്തു.";
            })
            .catch(error => {
                console.error('Error fetching CSV:', error);
                document.getElementById('syncStatus').innerText = "ഷീറ്റ് ഡാറ്റ ലോഡ് ചെയ്യുന്നതിൽ പരാജയപ്പെട്ടു.";
            });
    }

    function parseCSV(text) {
        let lines = text.split('\n');
        entries = [];
        total = 0;

        // ആദ്യ വരി (Header: house Name, amount) ഒഴിവാക്കാൻ i = 1 മുതൽ തുടങ്ങുന്നു
        for (let i = 1; i < lines.length; i++) {
            let line = lines[i].trim();
            if (line) {
                let columns = line.split(',');
                if (columns.length >= 2) {
                    let house = columns[0].replace(/^["']|["']$/g, '').trim();
                    let amt = parseFloat(columns[1].replace(/^["']|["']$/g, '').trim());
                    
                    if (house && !isNaN(amt)) {
                        entries.push({ house: house, amount: amt });
                        total += amt;
                    }
                }
            }
        }
        updateUI();
    }

    function addEntry() {
        let house = document.getElementById('houseName').value.trim();
        let amt = parseFloat(document.getElementById('amount').value);

        if (house === "" || isNaN(amt) || amt <= 0) {
            alert("ദയവായി വീടിന്റെ പേരും ശരിയായ തുകയും നൽകുക!");
            return;
        }

        entries.push({ house: house, amount: amt });
        total += amt;

        updateUI();

        // ഇൻപുട്ട് ഫീൽഡുകൾ ക്ലിയർ ചെയ്യുക
        document.getElementById('houseName').value = '';
        document.getElementById('amount').value = '';
        document.getElementById('houseName').focus();

        // ശ്രദ്ധിക്കുക: ഗൂഗിൾ ഷീറ്റിലേക്ക് നേരിട്ട് ഡാറ്റ സേവ് ആകാൻ ഗൂഗിൾ ആപ്സ് സ്ക്രിപ്റ്റ് (Google Apps Script) വെബ് ആപ്പ് കൂടി സജ്ജീകരിക്കേണ്ടതുണ്ട്.
    }

    function updateUI() {
        document.getElementById('totalAmount').innerText = total;
        let listContainer = document.getElementById('listContainer');
        listContainer.innerHTML = '';

        entries.forEach((item, index) => {
            let div = document.createElement('div');
            div.className = 'list-item';
            div.innerHTML = `<span>${index + 1}. ${item.house}</span> <span>₹${item.amount} <button class="delete-btn" onclick="removeItem(${index})">X</button></span>`;
            listContainer.appendChild(div);
        });
    }

    function removeItem(index) {
        total -= entries[index].amount;
        entries.splice(index, 1);
        updateUI();
    }
</script>

</body>
</html>
